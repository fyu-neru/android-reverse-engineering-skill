FILE:plugins/android-reverse-engineering/skills/android-reverse-engineering/scripts/decompile.sh
FIND:  trap 'if [[ -n "${XAPK_EXTRACTED_DIR:-}" ]] && [[ -d "$XAPK_EXTRACTED_DIR" ]]; then rm -rf "$XAPK_EXTRACTED_DIR"; fi' EXIT INT TERM
REPLACE:  trap 'if [[ -n "${XAPK_EXTRACTED_DIR:-}" ]] && [[ -d "$XAPK_EXTRACTED_DIR" ]]; then rm -rf "$XAPK_EXTRACTED_DIR"; fi' EXIT
EXPECT:D3 (signal): SIGTERM mid-XAPK-extraction still removes the temp dir
REQUIRES:posix-signals
