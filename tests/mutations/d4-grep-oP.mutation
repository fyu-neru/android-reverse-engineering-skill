FILE:plugins/android-reverse-engineering/skills/android-reverse-engineering/scripts/check-deps.sh
FIND:    java_version=$(echo "$java_version_output" | sed -n 's/[^0-9]*\([0-9][0-9]*\).*/\1/p;q')
REPLACE:    java_version=$(echo "$java_version_output" | grep -oP '[0-9]+' | sed -n '1p')
EXPECT:no grep -oP / -P (GNU only)
